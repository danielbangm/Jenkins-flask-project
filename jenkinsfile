pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t my-flask-app .'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application...'
                sh 'docker run --rm my-flask-app python -m py_compile app.py'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh 'docker stop my-flask-container || true'
                sh 'docker rm my-flask-container || true'
                sh 'docker run -d --name my-flask-container -p 5000:5000 my-flask-app'
            }
        }
    }
}